{
  "name": "reelsmaker",
  "version": "2.0.0",
  "private": true,
  "description": "ReelsMaker — morphing motion-graphics Instagram Reels with Remotion: one protagonist, a unique choreography per reel (1080x1920, 30fps, <=60s)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "remotion studio src/index.ts",
    "new": "node scripts/new-reel.mjs",
    "reel": "node scripts/reel.mjs",
    "demo": "node scripts/reel.mjs LiftForLater",
    "typecheck": "tsc --noEmit",
    "fonts": "node scripts/generate-fonts.mjs",
    "postinstall": "node scripts/generate-fonts.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@remotion/cli": "4.0.447",
    "remotion": "4.0.447",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.2"
  }
}
